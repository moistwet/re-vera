# Re-Vera backend — example environment.
#
# Copy to backend/.env and fill in real values there. .env is gitignored and must
# never be committed; this file must never contain a real key.
#
#   cp .env.example .env

# --- Service ------------------------------------------------------------------

# Redis connection URL. Matches docker-compose.yml (or a native redis-server).
REDIS_URL=redis://localhost:6379/0

# CORS origin allowed to call this API. During development the unpacked
# extension's id is unknown, so the wildcard form is the default; pin it to the
# real chrome-extension://<id> before shipping.
ALLOWED_EXTENSION_ORIGIN=chrome-extension://*

# --- Cost controls ------------------------------------------------------------
# These bound what one day of Re-Vera can spend. Do not raise them "for testing"
# outside local dev — the 7-day URL cache and the daily cap are the two things
# standing between a demo and a surprising bill.

# Checks allowed per install ID per day (Asia/Singapore).
DAILY_CAP=20

# Maximum claims verified per article. The biggest single lever on the cost of
# one check: retrieval, stance scoring and judging are all paid per claim.
MAX_CLAIMS=8

# Passages kept per claim after retrieval and de-duplication. Stage 3 and stage
# 4 are billed by the length of what they read.
MAX_PASSAGES_PER_CLAIM=6

# Article text is truncated to this many characters before extraction — roughly
# 3,000 tokens, about 2,000 words. A typical Singapore news article is well
# under it; this caps the one call in the pipeline that would otherwise have no
# ceiling on its input size.
MAX_ARTICLE_CHARS=12000

# Claims verified at once. Claims are worked concurrently so they stream in as
# they resolve; bounded so one reader's check cannot starve everyone else's.
PIPELINE_CONCURRENCY=4

# --- API keys -----------------------------------------------------------------
# Secrets live ONLY in backend/.env, which is gitignored. Never in this file,
# never in the repository, and never in the extension (the extension contains no
# secrets at all — it talks only to this backend).
#
# Both are read at the point of use, not at startup: the service boots, serves
# every milestone-1 route and runs its whole test suite with neither key set.
# A missing key produces a message naming the variable and what wanted it.

# Extraction, stance scoring, judging and web search.
OPENAI_API_KEY=

# Google Fact Check Tools (ClaimReview). Optional in a second sense: without it
# retrieval falls back to web search, which still works but costs more — a
# ClaimReview hit is what lets a claim skip the most expensive step it has.
GOOGLE_FACTCHECK_API_KEY=

# --- Models -------------------------------------------------------------------
# One per stage, so a single stage can be pointed at a stronger model during a
# test run without a code change (docs/decisions.md §7). Escalate a stage only
# when it fails the golden-set eval, never on a hunch — the judge is the usual
# candidate, since its output is the sentence a reader reads.
#
# IMPORTANT: the default below is ACCOUNT-DEPENDENT and was never verified
# against a live API from this repository. It is a mini-tier id the pinned
# OpenAI SDK knows about, nothing more. If your account cannot call it you will
# get a 4xx on the first check (loud, never retried) — set all three explicitly.
# Other mini-tier ids that may suit your account: gpt-4.1-mini, gpt-5-nano.
#
# Leave them unset to accept the default in app/config.py.

OPENAI_MODEL_EXTRACT=gpt-5-mini
OPENAI_MODEL_STANCE=gpt-5-mini
OPENAI_MODEL_JUDGE=gpt-5-mini

# Hard ceiling on one LLM call, in seconds. Enforced by app/llm.py itself, not
# only handed to the SDK, so a stalled call can never stall a reader's check.
LLM_TIMEOUT_SECONDS=30

# Retries AFTER the first attempt, so 2 means at most three calls. Only 5xx,
# timeouts and connection failures are ever retried; a 4xx never is, at any
# setting — a rejected request repeated is the same rejection, billed twice.
LLM_MAX_RETRIES=2

# --- Development switches -----------------------------------------------------

# Run the milestone-1 mock pipeline instead of the real one: six fictional
# fixture claims, no API key, no spend. For demos and for extension work.
# A deliberate switch, never a fallback — the real pipeline does not quietly
# degrade into this, because a reader shown fixture verdicts for their own
# article would have no way to tell.
USE_MOCK_PIPELINE=false

# Seconds between mock claim events, when USE_MOCK_PIPELINE is true.
MOCK_STEP_DELAY=0.85
