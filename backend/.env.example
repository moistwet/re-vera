# Re-Vera backend — example environment.
#
# Copy to backend/.env and fill in real values there. .env is gitignored and must
# never be committed; this file must never contain a real key.
#
#   cp .env.example .env

# --- Milestone 1 (used today) -------------------------------------------------

# Redis connection URL. Matches docker-compose.yml (or a native redis-server).
REDIS_URL=redis://localhost:6379/0

# CORS origin allowed to call this API. During development the unpacked
# extension's id is unknown, so the wildcard form is the default; pin it to the
# real chrome-extension://<id> before shipping.
ALLOWED_EXTENSION_ORIGIN=chrome-extension://*

# Checks allowed per install ID per day (Asia/Singapore). A cost control, not
# just an abuse control — do not raise it "for testing" outside local dev.
DAILY_CAP=20

# Maximum claims verified per article.
MAX_CLAIMS=8

# Seconds between mock claim events in the milestone-1 fake pipeline.
MOCK_STEP_DELAY=0.85

# --- Milestone 2 (real pipeline — not read yet) -------------------------------
# Uncomment and fill in backend/.env when the real pipeline lands. Never here.

# OPENAI_API_KEY=
# GOOGLE_FACTCHECK_API_KEY=
# OPENAI_MODEL_EXTRACT=
# OPENAI_MODEL_STANCE=
# OPENAI_MODEL_JUDGE=
